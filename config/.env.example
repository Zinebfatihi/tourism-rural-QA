# Copie ce fichier en « .env » (sans .example) et adapte les valeurs.
# Le fichier .env ne doit JAMAIS être versionné (il est dans .gitignore).

# URL du frontend lancé en local
BASE_URL=http://localhost:5173

# Navigateur : chrome ou firefox
BROWSER=chrome

# Mode sans interface graphique (true en CI/CD, false pour voir le navigateur)
HEADLESS=false

# Délais d'attente (secondes)
EXPLICIT_WAIT=10
PAGE_LOAD_TIMEOUT=30

# Identifiants de test (compte admin créé au démarrage du backend)
ADMIN_EMAIL=admin@saih.com
ADMIN_PASSWORD=Admin123!

# Compte hôte de test (déjà vérifié KYC) — mets TON mot de passe hôte ici
HOST_EMAIL=fatihizineb88@gmail.com
HOST_PASSWORD=
